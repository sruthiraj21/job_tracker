{
    "info": {
        "name": "JobTrackr API",
        "description": "Complete Postman collection for JobTrackr REST API - Day 05 Assignment",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000"
        },
        {
            "key": "createdId",
            "value": "1"
        }
    ],
    "item": [
        {
            "name": "Applications - GET",
            "item": [
                {
                    "name": "Get All Applications",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/api/applications"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Success should be true', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.success).to.eql(true);",
                                    "});",
                                    "",
                                    "pm.test('Response contains applications', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.data).to.be.an('array');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Filter Applications by Status",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/api/applications?status=Interview"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('All applications have Interview status', function () {",
                                    "    const response = pm.response.json();",
                                    "    response.data.forEach(app => {",
                                    "        pm.expect(app.status.toLowerCase()).to.eql('interview');",
                                    "    });",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Search Applications by Company",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/api/applications?search=google"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Search returns matching companies', function () {",
                                    "    const response = pm.response.json();",
                                    "    response.data.forEach(app => {",
                                    "        pm.expect(app.company.toLowerCase()).to.include('google');",
                                    "    });",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Get Application by ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/api/applications/1"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Application has an ID', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.data).to.have.property('id');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Applications - POST",
            "item": [
                {
                    "name": "Create Application",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"company\": \"Google\",\n    \"role\": \"Software Engineer\",\n    \"status\": \"Applied\",\n    \"location\": \"Bangalore\",\n    \"appliedDate\": \"2026-11-11\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/applications"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 201', function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test('Application created successfully', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.success).to.eql(true);",
                                    "    pm.expect(response.data.company).to.eql('Google');",
                                    "});",
                                    "",
                                    "const response = pm.response.json();",
                                    "pm.collectionVariables.set('createdId', response.data.id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Applications - PATCH",
            "item": [
                {
                    "name": "Update Application Status",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"status\": \"Interview\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/applications/{{createdId}}"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Application status updated', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.data.status).to.eql('Interview');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Applications - DELETE",
            "item": [
                {
                    "name": "Delete Application",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": "{{baseUrl}}/api/applications/{{createdId}}"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 204', function () {",
                                    "    pm.response.to.have.status(204);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Error Cases",
            "item": [
                {
                    "name": "Error 1 - Missing Company",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"company\": \"\",\n    \"role\": \"Developer\",\n    \"status\": \"Applied\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/applications"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 400', function () {",
                                    "    pm.response.to.have.status(400);",
                                    "});",
                                    "",
                                    "pm.test('Company validation error exists', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.success).to.eql(false);",
                                    "    pm.expect(response.errors).to.have.property('company');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Error 2 - Missing Role",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"company\": \"Google\",\n    \"role\": \"\",\n    \"status\": \"Applied\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/applications"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 400', function () {",
                                    "    pm.response.to.have.status(400);",
                                    "});",
                                    "",
                                    "pm.test('Role validation error exists', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.success).to.eql(false);",
                                    "    pm.expect(response.errors).to.have.property('role');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Error 3 - Invalid Status",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"company\": \"Google\",\n    \"role\": \"Developer\",\n    \"status\": \"Unknown\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/applications"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 400', function () {",
                                    "    pm.response.to.have.status(400);",
                                    "});",
                                    "",
                                    "pm.test('Status validation error exists', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.success).to.eql(false);",
                                    "    pm.expect(response.errors).to.have.property('status');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Error 4 - Application Not Found",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/api/applications/99999"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 404', function () {",
                                    "    pm.response.to.have.status(404);",
                                    "});",
                                    "",
                                    "pm.test('Error response has consistent structure', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.success).to.eql(false);",
                                    "    pm.expect(response).to.have.property('message');",
                                    "    pm.expect(response).to.have.property('errors');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Error 5 - Unknown Route",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/api/unknown"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 404', function () {",
                                    "    pm.response.to.have.status(404);",
                                    "});",
                                    "",
                                    "pm.test('Unknown route returns error structure', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.success).to.eql(false);",
                                    "    pm.expect(response).to.have.property('message');",
                                    "    pm.expect(response).to.have.property('errors');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Event Loop",
            "item": [
                {
                    "name": "Slow API - Non Blocking",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/api/slow"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Slow API completed successfully', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.success).to.eql(true);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Block API - Blocking",
                    "request": {
                        "method": "GET",
